<UserControl x:Class="CAUCCampusNetwork.Views.StackStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CAUCCampusNetwork.Views"
             xmlns:vm="clr-namespace:CAUCCampusNetwork.ViewModels">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="BorderThickness" Value="0.8" />
            <Setter Property="Background" Value="{DynamicResource SubtleCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleCardBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Online}">
                    <Setter Property="Background" Value="{DynamicResource OnlineFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource OnlineBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Offline}">
                    <Setter Property="Background" Value="{DynamicResource OfflineFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource OfflineBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Online}">
                    <Setter Property="Foreground" Value="{DynamicResource OnlineTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Offline}">
                    <Setter Property="Foreground" Value="{DynamicResource OfflineTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OnlineIconStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Online}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfflineIconStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Offline}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckingIconStyle" TargetType="views:SpinningRing">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Checking}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnknownIconStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static vm:StackCardState.Unknown}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,7">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />

                <Grid Width="15"
                      Height="15"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
                    <Grid Style="{StaticResource OnlineIconStyle}">
                        <Ellipse Fill="{DynamicResource OnlineTextBrush}" />
                        <Path Data="M 4.2,7.6 L 6.6,10.0 L 11.0,5.2"
                              Stroke="White"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>

                    <Grid Style="{StaticResource OfflineIconStyle}">
                        <Ellipse Fill="{DynamicResource OfflineTextBrush}" />
                        <Path Data="M 7.5,4.2 L 7.5,8.3 M 7.5,10.7 L 7.5,11.0"
                              Stroke="White"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Grid>

                    <views:SpinningRing Style="{StaticResource CheckingIconStyle}"
                                        RingSize="14"
                                        RingBrush="{DynamicResource SecondaryTextBrush}" />

                    <Grid Style="{StaticResource UnknownIconStyle}">
                        <Ellipse Stroke="{DynamicResource SecondaryTextBrush}"
                                 StrokeThickness="1.4"
                                 StrokeDashArray="2.2,2.0"
                                 Opacity="0.7" />
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource SubtitleTextStyle}" />
        </StackPanel>
    </Border>
</UserControl>
