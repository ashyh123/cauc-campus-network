<Window x:Class="CAUCCampusNetwork.Views.TrayPopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CAUCCampusNetwork.Views"
        xmlns:vm="clr-namespace:CAUCCampusNetwork.ViewModels"
        Title="CAUC 校园网"
        Width="312"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glowing overall status dot -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9.5" />
            <Setter Property="Height" Value="9.5" />
            <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallStatus}" Value="{x:Static vm:OverallStatusKind.DualStackOnline}">
                    <Setter Property="Fill" Value="{DynamicResource OnlineTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus}" Value="{x:Static vm:OverallStatusKind.PartialOrPending}">
                    <Setter Property="Fill" Value="{DynamicResource OfflineTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallStatus}" Value="{x:Static vm:OverallStatusKind.Busy}">
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small header spinner -->
        <Style x:Key="MiniSpinnerStyle" TargetType="views:SpinningRing">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Primary button spinner -->
        <Style x:Key="PrimarySpinnerStyle" TargetType="views:SpinningRing">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Header circle icon button -->
        <Style x:Key="HeaderCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CircleBg"
                                CornerRadius="14"
                                Background="{DynamicResource IconButtonFillBrush}"
                                BorderBrush="{DynamicResource SubtleCardBorderBrush}"
                                BorderThickness="0.6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CircleBg" Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CircleBg" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary capsule button -->
        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBg"
                                Height="38"
                                CornerRadius="19"
                                BorderThickness="0.8"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="#44FFFFFF">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Accent}">
                                <Setter TargetName="PillBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF0A84FF" Offset="0" />
                                            <GradientStop Color="#FF006EE6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PillBg" Property="BorderBrush" Value="#48FFFFFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Online}">
                                <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource OnlineFillBrush}" />
                                <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource OnlineBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Busy}">
                                <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBg" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBg" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch CheckBox style -->
        <Style x:Key="PillToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="32"
                                Height="18"
                                CornerRadius="9"
                                Background="{DynamicResource ToggleTrackOffBrush}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Margin" Value="16,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer pill button style -->
        <Style x:Key="FooterPillButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg"
                                CornerRadius="11"
                                Padding="9,5"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header icon path styles -->
        <Style x:Key="RefreshGlyphStyle" TargetType="Path">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopGlyphStyle" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Quota low warning value color styles -->
        <Style x:Key="RemainingFlowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowRemainingFlow}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OfflineTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BalanceValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowBalance}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OfflineTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            Padding="14"
            Background="{DynamicResource PopoverBackgroundBrush}"
            BorderBrush="{DynamicResource PopoverBorderBrush}"
            BorderThickness="1">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="4,0,4,11">
                <Grid Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource StatusDotStyle}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="CAUC 校园网"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <views:SpinningRing Margin="7,0,0,0"
                                            VerticalAlignment="Center"
                                            RingSize="13"
                                            RingBrush="{DynamicResource SecondaryTextBrush}"
                                            Style="{StaticResource MiniSpinnerStyle}" />
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource HeaderCircleButtonStyle}"
                            ToolTip="{Binding RefreshButtonHelpText}"
                            Click="OnRefreshOrStopClick">
                        <Grid Width="12" Height="12">
                            <Path Style="{StaticResource RefreshGlyphStyle}"
                                  Data="M 10.2,4.4 A 4.6,4.6 0 1 0 10.4,7.8 M 10.6,1.8 L 10.6,4.7 L 7.7,4.7"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Path Style="{StaticResource StopGlyphStyle}"
                                  Data="M 2.5,2.5 L 9.5,9.5 M 9.5,2.5 L 2.5,9.5"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Message}"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="34"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding LastCheckedTime}"
                               Visibility="{Binding HasLastCheckedTime, Converter={StaticResource BoolToVis}}"
                               FontSize="10.5"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Opacity="0.78"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Dual Stack Section -->
            <Grid Margin="0,0,0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:StackStatusCard Grid.Column="0"
                                       Title="IPv4"
                                       State="{Binding IPv4State}"
                                       Subtitle="{Binding IPv4Subtitle}" />
                <views:StackStatusCard Grid.Column="2"
                                       Title="IPv6"
                                       State="{Binding IPv6State}"
                                       Subtitle="{Binding IPv6Subtitle}" />
            </Grid>

            <!-- Quota Card -->
            <Border Margin="0,0,0,11"
                    Padding="14,11"
                    CornerRadius="14"
                    Background="{DynamicResource SubtleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleCardBorderBrush}"
                    BorderThickness="0.8"
                    Visibility="{Binding HasDisplayedQuota, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 1.5,10.5 L 1.5,6.2 M 5.2,10.5 L 5.2,2.4 M 8.9,10.5 L 8.9,4.5"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="11"
                                  Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="校园网额度"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                CornerRadius="8"
                                Padding="7,2"
                                Background="{DynamicResource PillBackgroundBrush}"
                                Visibility="{Binding HasQuotaAccountId, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding QuotaAccountIdText}"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="剩余流量"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding QuotaRemainingText}"
                                       Style="{StaticResource RemainingFlowValueStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="1"
                                Height="28"
                                Margin="10,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DividerBrush}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="账户余额"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="{Binding QuotaBalanceText}"
                                       Style="{StaticResource BalanceValueStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,9,0,0"
                                Visibility="{Binding ShowQuotaBottomSection, Converter={StaticResource BoolToVis}}">
                        <Border Height="0.8"
                                Background="{DynamicResource DividerBrush}"
                                Margin="0,0,0,8" />

                        <Grid Visibility="{Binding ShowQuotaDetailsRow, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UsedDisplayText}"
                                       Visibility="{Binding HasUsedText, Converter={StaticResource BoolToVis}}"
                                       FontSize="10.5"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding IPv6UsedDisplayText}"
                                       Visibility="{Binding HasIPv6Used, Converter={StaticResource BoolToVis}}"
                                       FontSize="10.5"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{Binding CachedQuotaHintText}"
                                   Visibility="{Binding HasCachedQuotaHint, Converter={StaticResource BoolToVis}}"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quota Unavailable Hint Card -->
            <Border Margin="0,0,0,11"
                    Padding="14,11"
                    CornerRadius="14"
                    Background="{DynamicResource SubtleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleCardBorderBrush}"
                    BorderThickness="0.8"
                    Visibility="{Binding ShowQuotaUnreachableHint, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.3" />
                            <Path Data="M 6.5,3.8 L 6.5,4.1 M 6.5,5.8 L 6.5,9.3"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="校园网额度暂不可读取"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="当前无法直连 192.168.100.200，若开启了 VPN/TUN 请放行网关，或检查 Windows 防火墙设置。"
                               FontSize="10.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="15" />
                </StackPanel>
            </Border>

            <!-- Primary Action Button -->
            <Button Margin="0,0,0,11"
                    Style="{StaticResource PrimaryPillButtonStyle}"
                    Click="OnPrimaryActionClick">
                <Grid>
                    <!-- Busy state content -->
                    <Grid Margin="14,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Busy}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <views:SpinningRing Margin="0,0,8,0"
                                                RingSize="14"
                                                RingBrush="{DynamicResource PrimaryTextBrush}"
                                                Style="{StaticResource PrimarySpinnerStyle}" />
                            <TextBlock Text="{Binding PrimaryActionText}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="停止"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Online state content -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Online}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource OnlineTextBrush}" />
                            <Path Data="M 3.9,7.1 L 6.1,9.3 L 10.3,4.8"
                                  Stroke="White"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Grid>
                        <TextBlock Text="{Binding PrimaryActionText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnlineTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Accent (Start Authentication) content -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PrimaryButtonStyleKind}" Value="{x:Static vm:PrimaryButtonKind.Accent}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="M 7.2,1.0 L 2.2,7.5 L 6.2,7.5 L 5.0,13.0 L 10.8,6.0 L 6.6,6.0 Z"
                              Fill="White"
                              Width="12"
                              Height="14"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PrimaryActionText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Launch at Login Row -->
            <Border Margin="0,0,0,8"
                    Padding="12,9"
                    CornerRadius="12"
                    Background="{DynamicResource SubtleCardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleCardBorderBrush}"
                    BorderThickness="0.6">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M 4.4,2.8 A 5.2,5.2 0 1 0 9.6,2.8 M 7.0,1.2 L 7.0,5.8"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock Text="开机自动启动"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Opacity="0.9"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource PillToggleSwitchStyle}"
                                  IsChecked="{Binding LaunchAtLogin.IsEnabled, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="{Binding LaunchAtLogin.StatusHint}"
                               Visibility="{Binding LaunchAtLogin.HasStatusHint, Converter={StaticResource BoolToVis}}"
                               FontSize="10.5"
                               Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               Margin="21,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <Grid Margin="2,0,2,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource FooterPillButtonStyle}"
                            Margin="0,0,4,0"
                            Click="OnOpenPortalClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.2" />
                                <Path Data="M 1.5,6.0 L 10.5,6.0 M 6.0,1.2 A 3.4,4.8 0 0 1 6.0,10.8 M 6.0,1.2 A 3.4,4.8 0 0 0 6.0,10.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" />
                            </Grid>
                            <TextBlock Text="认证页" FontSize="11.5" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FooterPillButtonStyle}"
                            Click="OnOpenWiFiSettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Path Data="M 1.5,4.8 A 6.5,6.5 0 0 1 10.5,4.8 M 3.2,7.1 A 4.0,4.0 0 0 1 8.8,7.1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" />
                                <Ellipse Width="2.2"
                                         Height="2.2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,1.2" />
                            </Grid>
                            <TextBlock Text="Wi-Fi 设置" FontSize="11.5" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Style="{StaticResource FooterPillButtonStyle}"
                        Click="OnQuitClick">
