<UserControl x:Class="CAUCCampusNetwork.Views.SpinningRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Width="{Binding RingSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Height="{Binding RingSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
             RenderTransformOrigin="0.5,0.5">
        <Viewbox.RenderTransform>
            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
        </Viewbox.RenderTransform>
        <Canvas Width="16" Height="16">
            <Ellipse Canvas.Left="1.5"
                     Canvas.Top="1.5"
                     Width="13"
                     Height="13"
                     Stroke="{DynamicResource DividerBrush}"
                     StrokeThickness="1.9" />
            <Path Data="M 8,1.5 A 6.5,6.5 0 0 1 14.5,8"
                  Stroke="{Binding RingBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  StrokeThickness="1.9"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
